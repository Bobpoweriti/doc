<link rel="stylesheet" href="{{{uiRootPath}}}/css/site.css">
<style>
/* ===== TOPBAR NAVIGATION ===== */
.navbar .home-link {
  filter: brightness(0) invert(1);
}
.edit-this-page {
  display: none !important;
}
.navbar-dropdown {
  background: #2d2d2d;
  border-top: none;
  box-shadow: 0 4px 12px rgba(0,0,0,.5);
}
.navbar-dropdown .navbar-item {
  color: rgba(255,255,255,.87);
}
.navbar-dropdown .navbar-item:hover {
  background: rgba(255,255,255,.1);
  color: #fff;
}
.navbar-brand .home-link {
  color: #fff;
  font-weight: 600;
}
.navbar-search {
  flex: 1;
  max-width: 380px;
  padding: 0 .75rem;
}
#search-input {
  width: 100%;
  background: rgba(255,255,255,.12);
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 4px;
  color: #fff;
  padding: .35rem .75rem;
  font-size: .9rem;
  outline: none;
}
#search-input::placeholder {
  color: rgba(255,255,255,.55);
}
#search-input:focus {
  background: rgba(255,255,255,.2);
  border-color: rgba(255,255,255,.5);
}

/* ===== PAGE D'ACCUEIL CARTES ===== */
article:has(.home-hero) h1.page {
  margin-bottom: .25rem;
}
.home-hero {
  padding: 0 0 2rem;
}
.home-subtitle {
  color: #666;
  font-size: .95rem;
  margin: 0 0 3rem;
}
.home-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}
@media (max-width: 768px) {
  .home-grid { grid-template-columns: 1fr; }
}
@media (min-width: 769px) and (max-width: 1024px) {
  .home-grid { grid-template-columns: repeat(2, 1fr); }
}
.home-card {
  border-radius: 10px;
  border: 2px solid #ddd;
  padding: 1.5rem 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-decoration: none;
  color: inherit;
  background: #fff;
  transition: transform .15s, box-shadow .15s;
  gap: .75rem;
}
a.home-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 4px 16px rgba(0,0,0,.1);
  text-decoration: none;
}
.home-card--soon { opacity: .55; cursor: default; }
.home-card--blue   { border-color: #3b82f6; }
.home-card--orange { border-color: #f97316; }
.home-card--green  { border-color: #22c55e; }
.home-card--purple { border-color: #a855f7; }
.home-card--cyan   { border-color: #06b6d4; }
.home-card--yellow { border-color: #eab308; }
.home-card-title {
  font-size: 1rem;
  font-weight: 700;
  color: #1a1a1a;
}
.home-card-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2rem;
  height: 2rem;
  padding: 0 .6rem;
  border-radius: 9999px;
  font-size: .85rem;
  font-weight: 700;
  color: #fff;
}
.home-card--blue   .home-card-badge { background: #3b82f6; }
.home-card--orange .home-card-badge { background: #f97316; }
.home-card--green  .home-card-badge { background: #22c55e; }
.home-card--purple .home-card-badge { background: #a855f7; }
.home-card--cyan   .home-card-badge { background: #06b6d4; }
.home-card--yellow .home-card-badge { background: #eab308; }
.home-card-badge--soon {
  background: #d1d5db !important;
  color: #6b7280;
  font-size: .75rem;
  font-weight: 500;
}
.home-card-desc {
  font-size: .8rem;
  color: #888;
  margin-top: .2rem;
}
.home-card--red    { border-color: #ef4444; }
.home-card--rose   { border-color: #f43f5e; }
.home-card--teal   { border-color: #14b8a6; }
.home-card--indigo { border-color: #6366f1; }

/* ===== NAV TOUJOURS DÉROULÉ ===== */
.nav-item > .nav-list {
  display: block !important;
}
.nav-item > .nav-item-toggle {
  transform: rotate(90deg);
}

/* ===== SÉPARATION CONTENU / NAV ===== */
main.article {
  background-color: #ffffff;
}
.nav-panel {
  background-color: #f8f9fb;
  border-right: 1px solid #dde1e7;
}
.toc-panel {
  background-color: #f8f9fb;
  border-left: 1px solid #dde1e7;
}

/* ===== IMPRESSION ===== */
@media print {
  #topbar,
  .nav-panel,
  .toc-panel,
  .breadcrumbs,
  .toolbar,
  .edit-this-page,
  footer.footer {
    display: none !important;
  }

  .body {
    display: block !important;
  }

  main.article {
    max-width: 100% !important;
    margin: 0 !important;
    padding: 1cm 0 0 0 !important;
  }

  h1, h2, h3, h4 { page-break-after: avoid; }
  table, .admonitionblock { page-break-inside: avoid; }

  @page { margin: 2cm; }
}
</style>
